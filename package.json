{
  "name": "otemanager",
  "version": "1.0.0",
  "description": "Over the Edge Article Management System",
  "type": "module",
  "scripts": {
    "predev": "node scripts/package-payment-helper.mjs",
    "prebuild": "node scripts/package-payment-helper.mjs",
    "payment-helper:package": "node scripts/package-payment-helper.mjs",
    "dev": "node --env-file-if-exists=.env.local ./node_modules/vite/bin/vite.js",
    "build": "vite build",
    "start": "node --env-file-if-exists=.env.local .output/server/index.mjs",
    "convex:dev": "convex dev",
    "convex:deploy": "convex deploy",
    "setup:local": "node scripts/setup-local.mjs",
    "backup:import": "node --env-file-if-exists=.env.local --import tsx scripts/import-backup.ts",
    "test": "vitest run",
    "typecheck": "tsc --noEmit && tsc --noEmit -p convex/tsconfig.json",
    "backup:verify": "node --env-file-if-exists=.env.local --import tsx scripts/verify-backup.ts"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "dependencies": {
    "@tanstack/react-query": "5.62.16",
    "@tanstack/react-router": "^1.166.7",
    "@tanstack/react-start": "^1.166.7",
    "archiver": "^7.0.1",
    "convex": "^1.45.0",
    "docx": "^9.5.1",
    "docx-preview": "^0.3.7",
    "jszip": "^3.10.1",
    "lucide-react": "0.460.0",
    "mammoth": "^1.11.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "recharts": "^3.6.0",
    "sharp": "^0.35.5",
    "yauzl": "^3.4.0",
    "zod": "^3.24.2"
  },
  "devDependencies": {
    "@edge-runtime/vm": "^5.0.0",
    "@types/archiver": "^7.0.0",
    "@types/node": "^22.0.0",
    "@types/react": "^19.0.8",
    "@types/react-dom": "^19.0.3",
    "@types/yauzl": "^3.4.0",
    "@vitejs/plugin-react": "^4.6.0",
    "autoprefixer": "10.4.20",
    "buffer": "^6.0.3",
    "convex-test": "^0.0.57",
    "happy-dom": "^21.0.1",
    "nitro": "3.0.1-alpha.2",
    "postcss": "8.4.49",
    "prettier": "^3.9.6",
    "tailwindcss": "3.4.16",
    "tsx": "^4.23.13",
    "typescript": "5.7.2",
    "vite": "^7.3.1",
    "vite-tsconfig-paths": "^5.1.4",
    "vitest": "^5.0.0"
  },
  "engines": {
    "node": ">=24.0.0 <25"
  }
}
