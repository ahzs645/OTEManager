# PDF files may contain only printable bytes but must not be reviewed as text.
*.pdf binary
*.idml binary
*.designcraft binary

# Preserve the upstream font licence notices byte-for-byte.
**/OFL-*.txt whitespace=-blank-at-eol

# Historical article exports preserve source whitespace verbatim.
public/designcraft/source-archive/articles/*.md -whitespace
# Preserve CSV's record separators and literal multiline source fields.
public/designcraft/source-archive/articles.csv -text -whitespace
