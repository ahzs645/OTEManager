# Convex provides both the database and uploaded file storage.
# For a local deployment, run npm run setup:local to create .env.local.
CONVEX_URL=https://your-deployment.convex.cloud

# Generate a random secret and set the SAME value in the Convex deployment
# environment and the application server environment. Never prefix it with VITE_.
CONVEX_SERVER_SECRET=

MAX_FILE_SIZE=52428800
MAX_BACKUP_SIZE=5368709120
# Optional Power Automate webhook authentication
WEBHOOK_SECRET=
