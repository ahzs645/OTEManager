# Convex provides both the database and uploaded file storage.
# For a local deployment, run npm run setup:local to create .env.local.
CONVEX_URL=https://your-deployment.convex.cloud

# Generate a random secret and set the SAME value in the Convex deployment
# environment and the application server environment. Never prefix it with VITE_.
CONVEX_SERVER_SECRET=

MAX_FILE_SIZE=52428800
MAX_BACKUP_SIZE=5368709120
# Optional Power Automate webhook authentication
WEBHOOK_SECRET=

# Optional DesignCraft native composition engine: cli (Python + designcraft-cli, default)
# or wasm (bundled headless WebAssembly engine; no CLI or Python needed).
# DESIGNCRAFT_ENGINE=wasm

# Optional WordPress publishing (sends approved articles as drafts through the
# OTE Publisher plugin in extensions/wordpress-ote-publisher). Use a WordPress
# account with the "OTE Publisher" role and an application password. HTTPS is
# required except for localhost. Leave all three empty to turn it off.
WORDPRESS_SITE_URL=
WORDPRESS_USERNAME=
WORDPRESS_APP_PASSWORD=
# Optional category slug assigned to new drafts (must already exist in WordPress).
# WORDPRESS_DEFAULT_CATEGORY=news
