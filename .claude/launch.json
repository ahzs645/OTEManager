{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "otemanager-dev",
      "runtimeExecutable": "/opt/homebrew/opt/node@24/bin/node",
      "runtimeArgs": [
        "--env-file-if-exists=.env.local",
        "./node_modules/vite/bin/vite.js",
        "--port",
        "5174",
        "--strictPort"
      ],
      "port": 5174
    },
    {
      "name": "otemanager-dev-utc",
      "runtimeExecutable": "/usr/bin/env",
      "runtimeArgs": [
        "TZ=UTC",
        "/opt/homebrew/opt/node@24/bin/node",
        "--env-file-if-exists=.env.local",
        "./node_modules/vite/bin/vite.js",
        "--port",
        "5175",
        "--strictPort"
      ],
      "port": 5175
    }
  ]
}